# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=10
TMP_DIR=/tmp
TMP_TTL_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AI_MAX=10
# Optional absolute engine paths (auto-detected when unset)
GHOSTSCRIPT_PATH=
QPDF_PATH=
LIBREOFFICE_PATH=
POPPLER_PATH=
CHROME_PATH=/home/ubuntu/.local/bin/google-chrome
PDFTOPPM_PATH=
VERAPDF_PATH=
PDFA_DEF_PATH=
# Optional AI/OCR integrations
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
OCR_LANG_PATH=
OCR_UNICODE_FONT_PATH=
# Auth integration secrets (never commit real values)
GOOGLE_OAUTH_CLIENT_ID=
JWT_SECRET=
